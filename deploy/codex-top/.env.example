# 复制为服务器 /opt/codex-top/.env，chmod 600；此文件不能包含账号密码。
# 留空项要求运维基线检查后填写，不能把示例当作生产已核实的参数。
CODEX_TOP_ROOT=/opt/codex-top
CODEX_TOP_IMAGE=
CODEX_TOP_PORT=
CODEX_TOP_PUBLIC_URL=
CODEX_TOP_CPUS=
CODEX_TOP_MEMORY=
CODEX_TOP_PIDS=
CODEX_TOP_LOG_SIZE=
CODEX_TOP_LOG_FILES=
# HTTPS 仅公开 TCP443；固定预装 Caddy 2.11.4 对应的 ID/digest，不填浮动标签。
# IP 只从上面的 PUBLIC_URL=https://公网IPv4 派生，不另填 PUBLIC_IP。
CODEX_TOP_HTTPS_IMAGE=
CODEX_TOP_HTTPS_CPUS=
CODEX_TOP_HTTPS_MEMORY=
CODEX_TOP_HTTPS_PIDS=
CODEX_TOP_HTTPS_LOG_SIZE=
CODEX_TOP_HTTPS_LOG_FILES=
# 下列为预检/备份预算；字节值均为十进制整数，不是 MiB。
CODEX_TOP_MIN_FREE_MEMORY_BYTES=
CODEX_TOP_MIN_FREE_DISK_BYTES=
CODEX_TOP_BACKUP_MAX_BYTES=
CODEX_TOP_BACKUP_MAX_COUNT=
# age 公钥可写入此文件；对应私钥离机保管，恢复时通过 --identity 指定。
CODEX_TOP_BACKUP_RECIPIENT=
# 启动健康等待和优雅停止的秒数。
CODEX_TOP_WAIT_SECONDS=
CODEX_TOP_STOP_SECONDS=
